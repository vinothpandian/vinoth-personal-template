# --- Database ---------------------------------------------------------------
# Use 127.0.0.1 (not "localhost"): Postgres.app rejects IPv6 (::1) connections
# unless you confirm a permission dialog. All apps share one Postgres server;
# this app's tables are isolated by the "personal_template_" prefix.
DATABASE_URL=postgres://vinoth@127.0.0.1:5432/personal_template

# --- Better Auth ------------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32
# Base URL of the web app (Better Auth needs it to build callback URLs)
BETTER_AUTH_URL=http://localhost:3000

# --- Pocket ID (OIDC provider) ----------------------------------------------
# Your Pocket ID instance base URL, e.g. https://id.example.com
POCKET_ID_ISSUER_URL=https://id.example.com
POCKET_ID_CLIENT_ID=your-pocket-id-client-id
POCKET_ID_CLIENT_SECRET=your-pocket-id-client-secret

# --- Single-user restriction ------------------------------------------------
# Only this identity may sign in. Set at least one; if both are set, either
# matching is enough. ALLOWED_SUBJECT is the OIDC "sub" claim from Pocket ID.
ALLOWED_EMAIL=you@example.com
ALLOWED_SUBJECT=

# --- CLI / worker auth ------------------------------------------------------
# Static secret the CLI sends as "Authorization: Bearer <token>".
# Generate with: openssl rand -hex 32
WORKER_TOKEN=change-me-openssl-rand-hex-32

# --- CLI only ---------------------------------------------------------------
# Where the CLI finds the running web app's API.
API_URL=http://localhost:3000
